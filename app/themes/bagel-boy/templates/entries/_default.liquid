<article class="bb-wrap bb-entry">
  <h1>{{ entry.title }}</h1>

  {% assign body_html = entry.data.body | markdown | strip %}
  {% if body_html != "" %}
    <div class="prose">{{ body_html }}</div>
  {% endif %}

  {% assign sections_html = entry.data.sections | strip %}
  {% if sections_html != "" %}
    {{ sections_html }}
  {% endif %}
</article>
