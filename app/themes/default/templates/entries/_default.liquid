<article>
  <h1>{{ entry.title }}</h1>
  {% if entry.published_at %}
  <p class="meta">Published on {{ entry.published_at | date: "%B %d, %Y" }}</p>
  {% endif %}

  <div class="content prose">
    {{ entry.data.body | markdown }}
  </div>

  {% if entry.data.excerpt %}
  <div class="excerpt">
    <p><em>{{ entry.data.excerpt }}</em></p>
  </div>
  {% endif %}
</article>
