<article>
  <span class="kicker">Shop Note</span>
  <h1>{{ entry.title }}</h1>
  {% if entry.published_at %}
    <p class="meta">Posted {{ entry.published_at | date: "%B %d, %Y" }}</p>
  {% endif %}

  <div class="content">
    {{ entry.data.body | markdown }}
  </div>

  {% if entry.data.excerpt %}
    <aside class="excerpt">{{ entry.data.excerpt }}</aside>
  {% endif %}
</article>
