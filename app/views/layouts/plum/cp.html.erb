<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">
<head>
  <title>Plum CMS</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= favicon_link_tag "plum-mark.svg", type: "image/svg+xml" %>
  <%= stylesheet_link_tag "plum/control_panel", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body class="h-full">
  <div class="min-h-full">
    <!-- Sidebar -->
    <div class="fixed inset-y-0 left-0 w-64 bg-[#241B27]">
      <div class="flex flex-col h-full">
        <!-- Logo -->
        <div class="flex items-center h-16 px-5 border-b border-white/10 bg-[#1E1621]">
          <%= link_to cp_root_path, class: "flex items-center gap-3 text-white" do %>
            <%= image_tag "plum-mark.svg", alt: "", class: "h-9 w-9 shrink-0" %>
            <span class="leading-tight">
              <span class="block text-lg font-semibold tracking-normal">Plum</span>
              <span class="block text-xs font-medium text-[#C9B7C2]">CMS</span>
            </span>
          <% end %>
        </div>

        <!-- Navigation -->
        <nav class="flex-1 px-4 py-6 space-y-2 overflow-y-auto">
          <%= link_to "Dashboard", cp_root_path,
              class: "flex items-center px-4 py-2 text-sm font-medium rounded-md #{request.path == cp_root_path ? 'bg-white/10 text-white' : 'text-[#D9CBD4] hover:bg-white/10 hover:text-white'}" %>

          <div class="pt-4">
            <p class="px-4 text-xs font-semibold text-[#A8929F] uppercase tracking-wider">Content</p>
            <% Plum::ContentType.for_site(current_site).each do |ct| %>
              <%= link_to ct.name, cp_content_type_path(ct),
                  class: "flex items-center px-4 py-2 mt-2 text-sm font-medium rounded-md #{request.path.include?("/cp/content_types/#{ct.id}") ? 'bg-white/10 text-white' : 'text-[#D9CBD4] hover:bg-white/10 hover:text-white'}" %>
            <% end %>
            <%= link_to "+ New Type", new_cp_content_type_path,
                class: "flex items-center px-4 py-2 mt-2 text-sm font-medium text-[#E6B3CB] hover:text-white" %>
            <%= link_to "Assets", cp_assets_path,
                class: "flex items-center px-4 py-2 mt-2 text-sm font-medium rounded-md #{request.path.include?('/cp/assets') ? 'bg-white/10 text-white' : 'text-[#D9CBD4] hover:bg-white/10 hover:text-white'}" %>
            <%= link_to "Globals", cp_globals_path,
                class: "flex items-center px-4 py-2 mt-2 text-sm font-medium rounded-md #{request.path.include?('/cp/globals') ? 'bg-white/10 text-white' : 'text-[#D9CBD4] hover:bg-white/10 hover:text-white'}" %>
            <%= link_to "Navigation", cp_nav_menus_path,
                class: "flex items-center px-4 py-2 mt-2 text-sm font-medium rounded-md #{request.path.include?('/cp/nav_menus') ? 'bg-white/10 text-white' : 'text-[#D9CBD4] hover:bg-white/10 hover:text-white'}" %>
            <%= link_to "Forms", cp_form_definitions_path,
                class: "flex items-center px-4 py-2 mt-2 text-sm font-medium rounded-md #{request.path.include?('/cp/forms') ? 'bg-white/10 text-white' : 'text-[#D9CBD4] hover:bg-white/10 hover:text-white'}" %>
          </div>

          <div class="pt-4">
            <p class="px-4 text-xs font-semibold text-[#A8929F] uppercase tracking-wider">Settings</p>
            <%= link_to "Site Settings", cp_site_settings_path,
                class: "flex items-center px-4 py-2 mt-2 text-sm font-medium rounded-md #{request.path.include?('/cp/site_settings') ? 'bg-white/10 text-white' : 'text-[#D9CBD4] hover:bg-white/10 hover:text-white'}" %>
            <%= link_to "Themes", cp_themes_path,
                class: "flex items-center px-4 py-2 mt-2 text-sm font-medium rounded-md #{request.path.include?('/cp/themes') ? 'bg-white/10 text-white' : 'text-[#D9CBD4] hover:bg-white/10 hover:text-white'}" %>
          </div>
        </nav>

        <!-- User -->
        <div class="flex items-center p-4 border-t border-white/10">
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-white truncate"><%= current_user_label %></p>
          </div>
          <% if plum_managed_auth? %>
            <%= button_to "Logout", logout_path, method: :delete,
                class: "ml-2 px-3 py-1 text-xs font-medium text-[#D9CBD4] hover:text-white" %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Main content -->
    <div class="pl-64">
      <main class="py-8 px-8">
        <% if flash[:notice] %>
          <div class="mb-6 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded">
            <%= flash[:notice] %>
          </div>
        <% end %>
        <% if flash[:alert] %>
          <div class="mb-6 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded">
            <%= flash[:alert] %>
          </div>
        <% end %>
        <%= yield %>
      </main>
    </div>
  </div>
</body>
</html>
