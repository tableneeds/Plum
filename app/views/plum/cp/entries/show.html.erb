<div class="flex items-center justify-between mb-8">
  <div>
    <h1 class="text-2xl font-bold text-gray-900"><%= @entry.title %></h1>
    <p class="mt-1 text-sm text-gray-500">/<%= @entry.slug %></p>
  </div>
  <div class="flex space-x-3">
    <% if @entry.published? %>
      <%= link_to "View", "/#{@entry.slug}", target: "_blank",
          class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" %>
    <% end %>
    <%= link_to "Edit", edit_cp_content_type_entry_path(@content_type, @entry),
        class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-purple-600 hover:bg-purple-700" %>
  </div>
</div>

<div class="bg-white shadow rounded-lg p-6">
  <dl class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    <div>
      <dt class="text-sm font-medium text-gray-500">Status</dt>
      <dd class="mt-1">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= @entry.published? ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
          <%= @entry.status %>
        </span>
      </dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">Published At</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @entry.published_at&.strftime("%B %d, %Y at %I:%M %p") || "Not published" %></dd>
    </div>
    <% @content_type.fields.each do |field| %>
      <div class="<%= %w[rich_text image blocks].include?(field['type']) ? 'sm:col-span-2' : '' %>">
        <dt class="text-sm font-medium text-gray-500"><%= field['label'] || field['handle'].titleize %></dt>
        <dd class="mt-1 text-sm text-gray-900">
          <% value = @entry.field_value(field['handle']) %>
          <% if field['type'] == 'blocks' %>
            <% blocks = value.is_a?(Array) ? value : [] %>
            <% if blocks.empty? %>
              <span class="text-gray-400">No blocks</span>
            <% else %>
              <% block_defs = (@content_type.site.theme.blocks || []).index_by { |b| b['handle'] } %>
              <ol class="space-y-3">
                <% blocks.each_with_index do |block, index| %>
                  <% next unless block.is_a?(Hash) %>
                  <% definition = block_defs[block['type'].to_s] %>
                  <li class="rounded-lg border border-gray-200 bg-gray-50 p-3">
                    <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">
                      <%= index + 1 %>. <%= definition ? definition['label'] : block['type'] %>
                      <% unless definition %><span class="text-red-500">(unknown block type)</span><% end %>
                    </p>
                    <dl class="mt-2 space-y-1">
                      <% (block['fields'] || {}).each do |handle, field_value| %>
                        <% next if field_value.blank? %>
                        <div class="flex gap-2">
                          <dt class="font-medium text-gray-500"><%= handle.to_s.titleize %>:</dt>
                          <dd class="text-gray-800 truncate"><%= field_value.to_s.truncate(120) %></dd>
                        </div>
                      <% end %>
                    </dl>
                  </li>
                <% end %>
              </ol>
            <% end %>
          <% elsif field['type'] == 'rich_text' %>
            <div class="prose max-w-none"><%= raw value %></div>
          <% elsif field['type'] == 'boolean' %>
            <%= value ? 'Yes' : 'No' %>
          <% elsif field['type'] == 'image' %>
            <% asset = current_site.assets.with_attached_file.find_by(id: value) if value.present? %>
            <% if asset %>
              <div class="overflow-hidden rounded-lg border border-gray-200 bg-gray-100">
                <%= image_tag plum_asset_image_url(asset), alt: asset.alt_text.to_s, class: "h-44 w-full object-cover" %>
              </div>
              <p class="mt-2 text-xs text-gray-500"><%= plum_asset_label(asset) %></p>
            <% else %>
              —
            <% end %>
          <% elsif field['type'] == 'relationship' %>
            <% related_entry = current_site.entries.includes(:content_type).find_by(id: value) if value.present? %>
            <% if related_entry %>
              <%= link_to related_entry.title, cp_content_type_entry_path(related_entry.content_type, related_entry), class: "text-purple-600 hover:text-purple-900" %>
              <span class="text-gray-500">(<%= related_entry.content_type.name %>)</span>
            <% else %>
              —
            <% end %>
          <% else %>
            <%= value %>
          <% end %>
        </dd>
      </div>
    <% end %>
  </dl>
</div>
