<div class="flex items-center justify-between mb-8">
  <div>
    <h1 class="text-2xl font-bold text-gray-900"><%= @entry.title %></h1>
    <p class="mt-1 text-sm text-gray-500">/<%= @entry.slug %></p>
  </div>
  <div class="flex space-x-3">
    <% if @entry.published? %>
      <%= link_to "View", "/#{@entry.slug}", target: "_blank",
          class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" %>
    <% end %>
    <%= link_to "Edit", edit_cp_content_type_entry_path(@content_type, @entry),
        class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-purple-600 hover:bg-purple-700" %>
  </div>
</div>

<div class="bg-white shadow rounded-lg p-6">
  <dl class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    <div>
      <dt class="text-sm font-medium text-gray-500">Status</dt>
      <dd class="mt-1">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= @entry.published? ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
          <%= @entry.status %>
        </span>
      </dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">Published At</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @entry.published_at&.strftime("%B %d, %Y at %I:%M %p") || "Not published" %></dd>
    </div>
    <% @content_type.fields.each do |field| %>
      <div class="<%= field['type'] == 'rich_text' ? 'sm:col-span-2' : '' %>">
        <dt class="text-sm font-medium text-gray-500"><%= field['label'] || field['handle'].titleize %></dt>
        <dd class="mt-1 text-sm text-gray-900">
          <% value = @entry.field_value(field['handle']) %>
          <% if field['type'] == 'rich_text' %>
            <div class="prose max-w-none"><%= raw value %></div>
          <% elsif field['type'] == 'boolean' %>
            <%= value ? 'Yes' : 'No' %>
          <% else %>
            <%= value %>
          <% end %>
        </dd>
      </div>
    <% end %>
  </dl>
</div>
